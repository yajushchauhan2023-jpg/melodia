generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  expired
}

enum Plan {
  free_trial
  pro
  elite
}

model User {
  id                   String             @id
  email                String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(expired)
  trialEndsAt          DateTime?
  currentPlan          Plan               @default(free_trial)
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  emailLogs            EmailLog[]


  // Marketplace (replaces subscriptions; legacy subscription fields above are deprecated)
  role                 Role               @default(student)
  teacherProfile       TeacherProfile?
  bookings             Booking[]          @relation("StudentBookings")
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String
  type      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

enum Role { student teacher admin }
enum TeacherStatus { pending approved rejected suspended }
enum BookingStatus { pending_payment confirmed completed cancelled refunded }
enum PaymentStatus { initiated succeeded failed refunded }

model TeacherProfile {
  id             String        @id @default(cuid())
  userId         String        @unique
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String
  bio            String
  instruments    String[]
  formats        String[]
  languages      String[]
  hourlyPrice    Int           // whole KSh
  qualifications String
  yearsExperience Int
  reviewNote     String?
  reviewedAt     DateTime?
  reviewedBy     String?
  timezone       String        @default("Africa/Nairobi")
  status         TeacherStatus @default(pending) // verification is an explicit admin action
  createdAt      DateTime      @default(now())
  availability   Availability[]
  bookings       Booking[]

  @@index([status])
}

model Availability {
  id         String         @id @default(cuid())
  teacherId  String
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  weekday    Int            // 0-6, in teacher's timezone
  startMin   Int            // minutes from midnight
  endMin     Int

  @@index([teacherId])
}

model Booking {
  id              String        @id @default(cuid())
  teacherId       String
  teacher         TeacherProfile @relation(fields: [teacherId], references: [id])
  studentId       String
  student         User          @relation("StudentBookings", fields: [studentId], references: [id])
  startsAt        DateTime      // always UTC
  durationMin     Int           @default(60)
  format          String
  status          BookingStatus @default(pending_payment)
  priceKsh        Int
  commissionKsh   Int
  teacherShareKsh Int
  idempotencyKey  String        @unique
  createdAt       DateTime      @default(now())
  payment         Payment?

  // Database-level double-booking guard
  @@unique([teacherId, startsAt])
  @@index([studentId])
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id])
  providerRef String?       @unique // webhook event/charge id: dedupes duplicate callbacks
  status      PaymentStatus @default(initiated)
  amountKsh   Int
  createdAt   DateTime      @default(now())
}
